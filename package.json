  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
